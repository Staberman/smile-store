{
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.smiletiendaimp.com.ar" }],
      "destination": "https://smiletiendaimp.com.ar/:path*",
      "permanent": true
    },
    {
      "source": "/productos/:slug",
      "destination": "/tienda/productos/:slug",
      "permanent": true
    },
    {
      "source": "/lentes-de-sol",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/tienda",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/tienda/",
      "destination": "/",
      "permanent": true
    }
  ]
}
